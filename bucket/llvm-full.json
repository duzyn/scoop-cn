            "hash": "854bffcfc84528e0ee92490ff5c178920abd358a79c3e98f053e41e3e8e4c6d2",
            "extract_dir": "clang+llvm-23.1.4-x86_64-pc-windows-msvc"
        },
        "arm64": {
