            "hash": "9a39756632480a42795ba5f39a81f7c0f56b338e6f8a924a8ddd66767ac0cd52"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/Scighost/Starward/releases/download/0.18.1/Starward_Portable_0.18.1_arm64.7z",
            "hash": "a497eab30b38c063bf484baa91c52569a9f4960bd3dad58acab1f207259001b2"
        }
    },
    "extract_dir": "Starward",
    "depends": "sqlite",
    "pre_install": [
        "if (-not (Test-Path \"$dir\\config.ini\"))",
        "{",
        "  New-Item \"$dir\\config.ini\" -ItemType File | Out-Null",
        "  Add-Content \"$dir\\config.ini\" \"Language=\"",
        "  Add-Content \"$dir\\config.ini\" \"UserDataFolder=$persist_dir\\data\"",
        "}"
    ],
    "post_install": [
        "sqlite3 \"$dir\\data\\StarwardDatabase.db\" \"CREATE TABLE IF NOT EXISTS Setting (Key TEXT PRIMARY KEY, Value TEXT);\"",
        "sqlite3 \"$dir\\data\\StarwardDatabase.db\" \"INSERT OR REPLACE INTO Setting (Key, Value) VALUES ('DefaultGameInstallationPath', '$persist_dir\\games');\""
    ],
    "shortcuts": [
        [
            "Starward.exe",
            "Starward"
        ]
    ],
    "persist": [
        "data",
        "games",
        "config.ini"
    ],
    "checkver": {
        "github": "https://github.com/Scighost/Starward"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/Scighost/Starward/releases/download/$version/Starward_Portable_$version_x64.7z"
            },
            "arm64": {
                "url": "https://gh-proxy.org/https://github.com/Scighost/Starward/releases/download/$version/Starward_Portable_$version_arm64.7z"
            }
        }
    }
}
