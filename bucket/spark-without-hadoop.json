{
    "version": "4.2.1",
    "description": "A unified analytics engine for large-scale data processing.",
    "homepage": "https://spark.apache.org/",
    "license": "Apache-2.0",
    "suggest": {
        "JDK": "openjdk"
    },
    "url": "https://archive.apache.org/dist/spark/spark-4.2.1/spark-4.2.1-bin-without-hadoop.tgz",
    "hash": "sha512:60781104f3c67a262676e0734ef517e54af1893aa68dd7105f2babd34ab32de74925d42e6f460744ae947e46fabac083e53f139180156fef20d1cdebca13e3d9",
    "extract_dir": "spark-4.2.1-bin-without-hadoop",
    "env_add_path": "bin",
    "env_set": {
        "SPARK_HOME": "$dir"
    },
    "persist": "conf",
    "checkver": {
        "url": "https://spark.apache.org/js/downloads.js",
        "regex": "addRelease\\(\"([\\d.]+)\","
    },
    "autoupdate": {
        "url": "https://archive.apache.org/dist/spark/spark-$version/spark-$version-bin-without-hadoop.tgz",
        "hash": {
            "url": "$url.sha512",
            "regex": "$basename: ([A-F0-9\\s]+)$"
        },
        "extract_dir": "spark-$version-bin-without-hadoop"
    }
}
