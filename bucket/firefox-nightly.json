    "notes": [
        "To set profile 'Scoop-Nightly' as *DEFAULT*, or profiles/settings was lost after update:",
        "  - Run 'Firefox Nightly Profile Manager', choose 'Scoop-Nightly' then click 'Start Nightly'.",
        "  - Visit 'about:profiles' page in Firefox Nightly to check *DEFAULT* profile.",
        "For details: https://support.mozilla.org/en-US/kb/profile-manager-create-remove-switch-firefox-profiles"
    ],
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/08/2026-08-20-09-27-44-mozilla-central/firefox-156.0a1.en-US.win64.installer.exe#/dl.7z",
            "hash": "sha512:93c742e6ff770eb8e5de4ae9d5c515b2d93ca32e4d629c26b287b513171b810d72bcc5245ae3959938ad5b4c4ad18c249e3124c31e14824bb0c68b816de572d6"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/08/2026-08-20-09-27-44-mozilla-central/firefox-156.0a1.en-US.win32.installer.exe#/dl.7z",
