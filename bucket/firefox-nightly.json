    "notes": [
        "To set profile 'Scoop-Nightly' as *DEFAULT*, or profiles/settings was lost after update:",
        "  - Run 'Firefox Nightly Profile Manager', choose 'Scoop-Nightly' then click 'Start Nightly'.",
        "  - Visit 'about:profiles' page in Firefox Nightly to check *DEFAULT* profile.",
        "For details: https://support.mozilla.org/en-US/kb/profile-manager-create-remove-switch-firefox-profiles"
    ],
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/08/2026-08-17-09-28-31-mozilla-central/firefox-156.0a1.en-US.win64.installer.exe#/dl.7z",
            "hash": "sha512:b8533c53d36748e0705fe1b67430c7603f6e7f681824e5392fa28d90508ebe62b3c4de85cb758b3d569d9d27f3241bce5559a05676c2698f9ca70b930d6d72d5"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/08/2026-08-17-09-28-31-mozilla-central/firefox-156.0a1.en-US.win32.installer.exe#/dl.7z",
