{
    "description": "Official General-Availability Release of OpenJDK",
    "homepage": "https://jdk.java.net/",
    "version": "26.0.2.1-1",
    "license": "GPL-2.0-only WITH Classpath-exception-2.0",
    "architecture": {
        "64bit": {
            "url": "https://download.java.net/java/GA/jdk26.0.2.1/3b8e6c7ec6274148a7aa15e7e7dfb53c/1/GPL/openjdk-26.0.2.1_windows-x64_bin.zip",
            "hash": "0c3a8a30993de864937e6bced5270edc39c80c584cfd359ac222638c42758f1c"
        }
    },
    "extract_dir": "jdk-26.0.2.1",
    "env_add_path": "bin",
    "env_set": {
        "JAVA_HOME": "$dir"
    },
    "checkver": {
        "url": "https://jdk.java.net/archive/",
        "re": "https://download\\.java\\.net/java/(?<type>GA)/(?<path>jdk(?<major>26(?:\\.[\\d]+)*)/[^/]+/(?<build>[\\d]+)(?:/GPL|/binaries)?)/(?<file>openjdk-(?<version>26(?:\\.[\\d]+)*)(?<ea>-ea)?(?:\\+[\\d]+)?_windows-x64_bin\\.(zip|tar.gz))",
        "replace": "${version}-${build}${ea}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.java.net/java/$matchType/$matchPath/$matchFile"
            }
        },
        "hash": {
            "url": "$url.sha256"
        },
        "extract_dir": "jdk-$matchVersion"
    }
}
