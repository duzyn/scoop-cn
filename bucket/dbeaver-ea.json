            "dbeaverc-ea"
        ]
    ],
    "shortcuts": [
        [
            "dbeaver.exe",
            "DBeaver EA"
        ]
    ],
    "checkver": {
        "url": "https://dbeaver.io/files/ea/",
        "regex": "href=\"dbeaver-ce-(?<ver>[\\d.]+)-windows-x86_64.zip\".*</td><td>(?<date>\\d{4}-\\d{2}-\\d{2}) \\d{2}:\\d{2}:\\d{2}</td>",
        "replace": "${ver}-${date}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dbeaver.io/files/ea/dbeaver-ce-$matchVer-windows-x86_64.zip"
