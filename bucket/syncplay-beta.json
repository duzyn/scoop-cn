{
    "version": "1.7.6",
    "description": "Solution to synchronize video playback across multiple instances of mpv, VLC, MPC-HC, MPC-BE and mplayer2 over the Internet.",
    "homepage": "https://syncplay.pl/",
    "license": "Apache-2.0",
    "suggest": {
        "vcredist": "vcredist2022"
    },
    "url": "https://gh-proxy.org/https://github.com/Syncplay/syncplay/releases/download/v1.7.6/Syncplay_1.7.6_Portable.zip",
    "hash": "b2e5d22dda78d6d1892ea9836fc642302dd7de9e29f6ded8af286a64d959de7c",
    "bin": "Syncplay.exe",
    "shortcuts": [
        [
            "Syncplay.exe",
            "Syncplay"
        ]
    ],
    "persist": "syncplay.ini",
    "checkver": {
        "github": "https://api.github.com/repos/Syncplay/syncplay/releases",
        "script": [
            "$releases = $page | ConvertFrom-Json",
            "if (($ver = $releases[0].tag_name)[0] -eq ($prefix = 'v')) { $ver = $ver.Substring(1) } else { $prefix = '' }",
            "$result = ($prefix, $ver, $ver.Replace('-', '_')) -join ' '",
            "$output = @{'result' = \"$result\"} | ConvertTo-Json -Compress",
            "Write-Output $output"
        ],
        "jsonpath": "$.result",
        "regex": "\\A(?<prefix>v)? (\\S+) (?<underscore>\\S+)\\Z"
    },
    "autoupdate": {
        "url": "https://gh-proxy.org/https://github.com/Syncplay/syncplay/releases/download/$matchPrefix$version/Syncplay_$matchUnderscore_Portable.zip"
    }
}
