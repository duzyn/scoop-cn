{
    "version": "1795388465.467ab6441a",
    "description": "Open source Nintendo Switch emulator (forked from yuzu — nightly build)",
    "homepage": "https://eden-emu.dev/",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://git.eden-emu.dev/eden-emu/eden/raw/branch/master/LICENSE.txt"
    },
    "notes": [
        "ATTENTION: Eden requires Nintendo Switch firmware and decryption keys to function.",
        "Learn more at https://git.eden-emu.dev/eden-emu/eden/src/branch/master/docs/user/QuickStart.md"
    ],
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://nightly.eden-emu.dev/v1795388465.467ab6441a/Eden-Windows-467ab6441a-amd64-clang-pgo.zip",
            "hash": "103ff120e86fc2447b7d69bb5764ab6d87f2100b9bef29879561d2e6d761d648"
        },
        "arm64": {
            "url": "https://nightly.eden-emu.dev/v1795388465.467ab6441a/Eden-Windows-467ab6441a-arm64-clang-pgo.zip",
            "hash": "2b2e3b8d1a2da4f1299a0bf71426fa786e9bb7fe8e072b8d456fdb58840ac036"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   New-item \"$persist_dir\\user\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:APPDATA\\eden\") {",
        "       Write-host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:APPDATA\\eden\\*\" -Destination \"$persist_dir\\user\" -Recurse",
        "       (Get-Content -Path \"$persist_dir\\user\\config\\qt-config.ini\" -Encoding UTF8).Replace('check_for_updates\\default=true', 'check_for_updates\\default=false').Replace('check_for_updates=true', 'check_for_updates=false') | Set-Content -Path \"$persist_dir\\user\\config\\qt-config.ini\" -Encoding UTF8",
        "       Remove-Item -Path \"$env:APPDATA\\eden\" -Recurse",
        "   } else {",
        "       New-Item \"$persist_dir\\user\\config\" -ItemType Directory -Force | Out-Null",
        "       '[UI]', 'check_for_updates\\default=false', 'check_for_updates=false' | Set-Content -Path \"$persist_dir\\user\\config\\qt-config.ini\"",
        "   }",
        "}"
    ],
    "bin": [
        [
            "eden.exe",
            "eden-nightly"
        ]
    ],
    "shortcuts": [
        [
            "eden.exe",
            "Eden (nightly)"
        ]
    ],
    "persist": "user",
    "checkver": {
        "url": "https://git.eden-emu.dev/api/v1/repos/eden-ci/nightly/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d]+\\.(?<commit>[a-f\\d]+))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.eden-emu.dev/v$version/Eden-Windows-$matchCommit-amd64-clang-pgo.zip"
            },
            "arm64": {
                "url": "https://nightly.eden-emu.dev/v$version/Eden-Windows-$matchCommit-arm64-clang-pgo.zip"
            }
        }
    }
}
