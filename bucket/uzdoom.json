{
    "version": "5.0.0",
    "description": "Feature-centric port for all Doom engine games, based on GZDoom, adding an advanced renderer and powerful scripting capabilities",
    "homepage": "https://zdoom.org/",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Place WAD files (game data) in:",
        "",
        "    $persist_dir\\..\\_doom"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/UZDoom/UZDoom/releases/download/5.0.0/Windows-UZDoom-Release-x86_64.zip",
            "hash": "ecdce3c6c3a262f56d2631fe5d933a9327f39777bd21d669009944de44e7c6ab"
        }
    },
    "pre_install": [
        "New-Item -ItemType Directory -Force -Path $persist_dir\\..\\_doom | Out-Null",
        "New-Item -Path $dir -Name uzdoom_portable.ini -ItemType File -ErrorAction Ignore | Out-Null"
    ],
    "env_set": {
        "DOOMWADDIR": "$persist_dir\\..\\_doom"
    },
    "bin": "uzdoom.exe",
    "shortcuts": [
        [
            "uzdoom.exe",
            "UZDoom"
        ]
    ],
    "persist": [
        "uzdoom_portable.ini",
        "Save",
        "Screenshots"
    ],
    "checkver": {
        "github": "https://github.com/UZDoom/UZDoom"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/UZDoom/UZDoom/releases/download/$version/Windows-UZDoom-Release-x86_64.zip"
            }
        }
    }
}
