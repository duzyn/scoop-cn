            "hash": "9f15b87242061fabdb71ae442047958e54601319019db0718998246d66f40b9e"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/sqlitebrowser/sqlitebrowser/releases/download/continuous/DB.Browser.for.SQLite-dev-23a6d0e-win-arm64.zip",
            "hash": "cbe0b8fb996f1e8b242db22ebeb04de6cf77d0c80fbb1124cddcf88fdb0489f0"
        }
