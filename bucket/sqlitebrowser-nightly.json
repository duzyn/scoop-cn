    "persist": "Data",
    "checkver": {
        "github": "https://api.github.com/repos/sqlitebrowser/sqlitebrowser/releases/tags/continuous",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "$date = Get-Date $release.updated_at -Format 'yyyyMMdd'",
            "$page -match 'SQLite-dev-(?<commit>[0-9a-f]{7})-win-x64.zip' | Out-Null",
            "$output = @{'result' = \"$date-$($matches['commit'])\"} | ConvertTo-Json -Compress",
            "Write-Output $output"
        ],
        "jsonpath": "$.result",
        "regex": "^(?<version>\\d{8}-(?<commit>[0-9a-f]{7}))$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/sqlitebrowser/sqlitebrowser/releases/download/continuous/DB.Browser.for.SQLite-dev-$matchCommit-win-x64.zip"
            },
            "32bit": {
                "url": "https://gh-proxy.org/https://github.com/sqlitebrowser/sqlitebrowser/releases/download/continuous/DB.Browser.for.SQLite-dev-$matchCommit-win-x86.zip"
            },
            "arm64": {
                "url": "https://gh-proxy.org/https://github.com/sqlitebrowser/sqlitebrowser/releases/download/continuous/DB.Browser.for.SQLite-dev-$matchCommit-win-arm64.zip"
            }
        }
    }
