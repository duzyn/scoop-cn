        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/sqlitebrowser/sqlitebrowser/releases/download/continuous/DB.Browser.for.SQLite-dev-ef88e35-win-arm64.zip",
            "hash": "9451f31d13403afc220f8b284d8e96ceb8d9c531aabac50eb33680efe84d7d9f"
