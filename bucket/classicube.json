{
    "version": "1.3.9",
    "description": "Custom Minecraft Classic compatible client",
    "homepage": "https://www.classicube.net/",
    "license": {
        "identifier": "BSD-3-Clause",
        "url": "https://github.com/ClassiCube/ClassiCube/blob/master/license.txt"
    },
    "architecture": {
        "32bit": {
            "url": "https://cdn.classicube.net/client/release/win32/ClassiCube.zip",
            "hash": "72cd3a8ad3ed806dbbd744fa15045ea16a39753da3e7f32eeac9ddba93c48745"
        },
        "64bit": {
            "url": "https://cdn.classicube.net/client/release/win64/ClassiCube.zip",
            "hash": "b5ce328f3ee06660a9571b06aed34bbc1aa33b5c8314ee3d4d84a3771ab9233c"
        }
    },
    "extract_dir": "ClassiCube",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   New-item \"$persist_dir\\fontscache.txt\" -ItemType File | Out-Null",
        "   New-item \"$persist_dir\\options.txt\" -ItemType File | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "ClassiCube.exe",
            "ClassiCube"
        ]
    ],
    "persist": [
        "audio",
        "logs",
        "maps",
        "plugins",
        "screenshots",
        "texpacks",
        "texturecache",
        "client.log",
        "fontscache.txt",
        "options.txt"
    ],
    "checkver": {
        "github": "https://github.com/ClassiCube/ClassiCube"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://cdn.classicube.net/client/release/win32/ClassiCube.zip"
            },
            "64bit": {
                "url": "https://cdn.classicube.net/client/release/win64/ClassiCube.zip"
            }
        }
    }
}
