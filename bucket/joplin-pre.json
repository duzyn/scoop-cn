    "url": "https://gh-proxy.org/https://github.com/laurent22/joplin/releases/download/v3.7.10/Joplin-Setup-3.7.10.exe#/dl.7z",
    "hash": "sha512:434f51f6c6b0fa996ff711fb9490755afe4dd9cbb946ddfb86c18355179e4f5ccb0951b7e58c444474267df2077a2bd57456909a9867f4d75bfe6ca96aa1b519",
    "architecture": {
        "64bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        },
        "32bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-32.7z\" \"$dir\""
