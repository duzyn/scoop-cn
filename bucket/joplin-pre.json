    "hash": "sha512:231f164398325b5c1c97f601a1127810856b61181ebd28b0b2cd8d77bc1a4764dfb024de048f7935fa6a08af07ba55d2e94b5fdaadacc02d3594f33d08f40e92",
    "architecture": {
        "64bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        },
        "32bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-32.7z\" \"$dir\""
