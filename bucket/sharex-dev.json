{
    "version": "22.4.0.2181",
    "description": "Screen capture, file sharing and productivity tool. (Dev. Version)",
    "homepage": "https://getsharex.com",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/ShareX/DevBuilds/releases/download/v22.4.0.2181/ShareX-22.4.0.2181-portable-x64.zip",
            "hash": "a9a9a632d2cc129de10b6db61c1dd7c473eca1a9cf36dcaf2d3f1448f1c3fe95"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\PersonalPath.cfg\")) { New-Item \"$dir\\PersonalPath.cfg\" | Out-Null }",
    "bin": "ShareX.exe",
    "shortcuts": [
        [
            "ShareX.exe",
            "ShareX Dev"
        ]
    ],
    "persist": [
        "PersonalPath.cfg",
        "ShareX"
    ],
    "checkver": {
        "github": "https://github.com/ShareX/DevBuilds",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/ShareX/DevBuilds/releases/download/v$version/ShareX-$version-portable-x64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/ShareX/DevBuilds/releases/tag/v$version",
            "regex": "$basename</td>\\s*<td><code>$sha256</code>"
        }
    }
}
