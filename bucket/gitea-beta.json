{
    "version": "28.1.0",
    "description": "Git with a cup of tea, painless self-hosted git service. (beta channel)",
    "homepage": "https://gitea.io/",
    "license": "MIT",
    "notes": "Run 'gitea web -c \"$persist_dir\\custom\\conf\\app.ini\"' to start the webserver",
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/go-gitea/gitea/releases/download/v28.1.0/gitea-28.1.0-windows-amd64.exe#/gitea.exe",
            "hash": "68495c963bab1bfcbbe5b48916c7f362a49aca931583575e09763a02ddf63e2d"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/go-gitea/gitea/releases/download/v28.1.0/gitea-28.1.0-windows-arm64.exe#/gitea.exe",
            "hash": "04e2bc31d61e8e3335be8816ea7fc6dea22fa723822d9a6159161f95a49bae5a"
        }
    },
    "post_install": [
        "echo 'Creating $persist_dir\\custom\\conf.app.ini'",
        "if(!(test-path \"$persist_dir\\custom\\conf\")) { mkdir \"$persist_dir\\custom\\conf\" > $null }",
        "if(!(test-path \"$persist_dir\\custom\\conf\\app.ini\")) {",
        "    $gitea = \"[database]`nPATH = $persist_dir/data/gitea.db\"",
        "    $gitea += \"`n[repository]`nROOT = $persist_dir/repositories\"",
        "    $gitea += \"`n[log]`nROOT_PATH = $persist_dir/log\"",
        "    echo $gitea | % {$_.replace(\"\\\",\"/\") } | out-file -encoding oem \"$persist_dir\\custom\\conf\\app.ini\"",
        "}"
    ],
    "bin": "gitea.exe",
    "checkver": {
        "github": "https://api.github.com/repos/go-gitea/gitea/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "^v([\\d.]+(-\\w+)?)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/go-gitea/gitea/releases/download/v$version/gitea-$version-windows-amd64.exe#/gitea.exe"
            },
            "arm64": {
                "url": "https://gh-proxy.org/https://github.com/go-gitea/gitea/releases/download/v$version/gitea-$version-windows-arm64.exe#/gitea.exe"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
