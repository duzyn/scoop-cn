{
    "version": "16.0.0",
    "description": "Woof! is a continuation of the Boom/MBF bloodline of Doom source ports",
    "homepage": "https://fabiangreffrath.github.io/woof/",
    "license": "GPL-2.0",
    "notes": [
        "Place your WAD files inside",
        "",
        "C:\\Users\\<username>\\scoop\\persist\\_doom\\"
    ],
    "suggest": {
        "Launcher (frontend)": [
            "doomrunner",
            "zdl"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/fabiangreffrath/woof/releases/download/woof_16.0.0/Woof-16.0.0-win64.zip",
            "hash": "1c7fd0afe9b1ab9517ab900fc4b4974282430e50cb57fe3291d6218f125ccd31",
            "extract_dir": "Woof-16.0.0-win64"
        },
        "32bit": {
            "url": "https://gh-proxy.org/https://github.com/fabiangreffrath/woof/releases/download/woof_16.0.0/Woof-16.0.0-win32.zip",
            "hash": "23e16f63a0915f5fe8f49c2afbc13acaa4ba8e8bbaf5a3d2221c505c024c17bd",
            "extract_dir": "Woof-16.0.0-win32"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\woof.cfg\")) {",
        "   New-Item -ItemType File \"$dir\\woof.cfg\" | Out-Null",
        "}",
        "if (!(Test-Path \"$scoopdir\\persist\\_doom\")) {",
        "   New-item \"$scoopdir\\persist\\_doom\" -ItemType Directory | Out-Null",
        "}"
    ],
    "env_set": {
        "DOOMWADDIR": "$persist_dir\\..\\_doom"
    },
    "bin": "woof.exe",
    "shortcuts": [
        [
            "woof.exe",
            "Woof!"
        ],
        [
            "woof-setup.exe",
            "Woof Setup"
        ]
    ],
    "persist": [
        "woof.cfg",
        "autoload",
        "savegames"
    ],
    "checkver": {
        "github": "https://github.com/fabiangreffrath/woof/",
        "re": "woof_([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/fabiangreffrath/woof/releases/download/woof_$version/Woof-$version-win64.zip",
                "extract_dir": "Woof-$version-win64"
            },
            "32bit": {
                "url": "https://gh-proxy.org/https://github.com/fabiangreffrath/woof/releases/download/woof_$version/Woof-$version-win32.zip",
                "extract_dir": "Woof-$version-win32"
            }
        }
    }
}
