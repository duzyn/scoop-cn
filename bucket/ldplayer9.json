{
    "version": "9.5.36.0",
    "description": "An Android emulator optimized for mobile gaming with lower resource consumption (Version 9).",
    "homepage": "https://www.ldplayer.net",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.ldplayer.net/other/terms-of-use.html"
    },
    "notes": "Administrator privileges are required to run repairer.",
    "url": "https://static.ldrescdn.com/download/package/LDPlayer_9.5.36.0.exe",
    "hash": "ad1f3b044118f2fbfefb61c3851454f0c3ca69cd53702a780750f55144308c00",
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\$fname\" \"$dir\\installer\" -Switches \"-t#\" -Removal",
            "Get-ChildItem -LiteralPath \"$dir\\installer\" -Filter '*.7z' -File | ForEach-Object {",
            "    Expand-7zipArchive $_.FullName $dir",
            "}",
            "Remove-Item \"$dir\\installer\" -Force -Recurse"
        ]
    },
    "shortcuts": [
        [
            "dnplayer.exe",
            "LDPlayer\\LDPlayer9"
        ],
        [
            "dnmultiplayer.exe",
            "LDPlayer\\LDMultiPlayer9"
        ],
        [
            "dnrepairer.exe",
            "LDPlayer\\LDPlayer9 Repairer"
        ]
    ],
    "uninstaller": {
        "file": "dnuninst.exe"
    },
    "persist": [
        "ldrecord\\video",
        "vms"
    ],
    "checkver": {
        "url": "https://www.ldplayer.net/other/version-history-and-release-notes.html",
        "regex": "download/package/LDPlayer_(9[\\d.]+)\\.exe"
    },
    "autoupdate": {
        "url": "https://static.ldrescdn.com/download/package/LDPlayer_$version.exe"
    }
}
