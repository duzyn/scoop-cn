            "hash": "021662d4ce1f94c4919952f9d868c73736506d83d3703712167c4f0ef828d906"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/MaaEnd/MaaEnd/releases/download/v2.34.0/MaaEnd-win-aarch64-v2.34.0.zip",
            "hash": "81f8927452b5e37472d2c873a91d015b145370fdc6af663859b7b9723c1ba788"
        }
    },
    "bin": "MaaEnd.exe",
    "shortcuts": [
