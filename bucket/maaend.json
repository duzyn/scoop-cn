            "hash": "fbaa35e407e62656a36ab7e922d3f0710b72d47c8e66a8cb545d2f8beb9f7fd3"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/MaaEnd/MaaEnd/releases/download/v2.28.0/MaaEnd-win-aarch64-v2.28.0.zip",
            "hash": "b4f1da7d1fe93ec9a21d3efcc2ddef1c94af0394bcac6e4b6917879a02e12bb2"
        }
    },
    "bin": "MaaEnd.exe",
    "shortcuts": [
