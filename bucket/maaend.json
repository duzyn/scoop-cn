        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/MaaEnd/MaaEnd/releases/download/v2.30.1/MaaEnd-win-aarch64-v2.30.1.zip",
            "hash": "74650d66ad8c938447331241584dc903d0129424f2d067f494c8596e2bff34d3"
        }
    },
    "bin": "MaaEnd.exe",
