{
    "version": "2126.0",
    "description": "Open source 3DS emulator project based on Citra",
    "homepage": "https://azahar-emu.org/",
    "license": {
        "identifier": "GPL-2.0-or-later",
        "url": "https://github.com/azahar-emu/azahar/blob/master/license.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/azahar-emu/azahar/releases/download/2126.0/azahar-windows-msys2-2126.0.zip",
            "hash": "fa64b69f8df00c16e0583d866d7f13a3c828df5298ddacdb7781bda1a8c272ce"
        }
    },
    "extract_dir": "azahar-windows-msys2-2126.0",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\user\")) {",
        "   New-Item -Path \"$persist_dir\" -Name \"user\" -ItemType \"directory\" | Out-Null",
        "   if (Test-Path \"$env:APPDATA\\Citra\") {",
        "       Write-host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:APPDATA\\Citra\\*\" -Destination \"$persist_dir\\user\" -Recurse",
        "       Remove-Item -Path \"$env:APPDATA\\Citra\" -Recurse",
        "   }",
        "}"
    ],
    "bin": "azahar.exe",
    "shortcuts": [
        [
            "azahar.exe",
            "Azahar"
        ]
    ],
    "persist": "user",
    "checkver": {
        "github": "https://github.com/azahar-emu/azahar"
    },
    "autoupdate": {
        "url": "https://gh-proxy.org/https://github.com/azahar-emu/azahar/releases/download/$version/azahar-windows-msys2-$version.zip",
        "extract_dir": "azahar-windows-msys2-$version"
    }
}
