{
    "version": "20.2.0",
    "description": "Basic variant of the K-Lite Codec Pack, a collection of DirectShow filters, VFW/ACM codecs and tools.",
    "homepage": "https://codecguide.com/about_kl.htm",
    "license": "Freeware",
    "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_2020_Basic.exe",
    "hash": "fbaba526ae69726bce5b787526a8de5d53e7ea6fa50f8c5562b8c4862dd9ea5f",
    "installer": {
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart",
            "/dir=$dir"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart"
        ]
    },
    "checkver": {
        "url": "https://codecguide.com/download_k-lite_codec_pack_basic.htm",
        "regex": "Version ([\\d.]+) Basic"
    },
    "autoupdate": {
        "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_$cleanVersion_Basic.exe",
        "hash": {
            "url": "https://codecguide.com/download_k-lite_codec_pack_basic.htm",
            "find": "([a-fA-F0-9]{64})"
        }
    }
}
