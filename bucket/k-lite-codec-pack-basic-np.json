{
    "version": "20.0.5",
    "description": "Basic variant of the K-Lite Codec Pack, a collection of DirectShow filters, VFW/ACM codecs and tools.",
    "homepage": "https://codecguide.com/about_kl.htm",
    "license": "Freeware",
    "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_2005_Basic.exe",
    "hash": "946bc6792b56f1a1927b91860d7667540844c65c3fd178c7494f55b77f27be06",
    "installer": {
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart",
            "/dir=$dir"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart"
        ]
    },
    "checkver": {
        "url": "https://codecguide.com/download_k-lite_codec_pack_basic.htm",
        "regex": "Version ([\\d.]+) Basic"
    },
    "autoupdate": {
        "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_$cleanVersion_Basic.exe",
        "hash": {
            "url": "https://codecguide.com/download_k-lite_codec_pack_basic.htm",
            "find": "([a-fA-F0-9]{64})"
        }
    }
}
