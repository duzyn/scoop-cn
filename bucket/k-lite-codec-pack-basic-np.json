{
    "version": "20.1.0",
    "description": "Basic variant of the K-Lite Codec Pack, a collection of DirectShow filters, VFW/ACM codecs and tools.",
    "homepage": "https://codecguide.com/about_kl.htm",
    "license": "Freeware",
    "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_2010_Basic.exe",
    "hash": "9df9f48a175ede3d8edf069cefb1e53462a92c1e0bec786c3649b119e928a9fc",
    "installer": {
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart",
            "/dir=$dir"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart"
        ]
    },
    "checkver": {
        "url": "https://codecguide.com/download_k-lite_codec_pack_basic.htm",
        "regex": "Version ([\\d.]+) Basic"
    },
    "autoupdate": {
        "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_$cleanVersion_Basic.exe",
        "hash": {
            "url": "https://codecguide.com/download_k-lite_codec_pack_basic.htm",
            "find": "([a-fA-F0-9]{64})"
        }
    }
}
