{
    "version": "25.0.5",
    "description": "High-performance, embeddable, polyglot Virtual Machine for JVM-langs (Java, Scala, Kotlin), JavaScript/NodeJS, Python, Ruby, R, and LLVM-langs (C, C++, Rust)",
    "homepage": "https://www.graalvm.org/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.oracle.com/downloads/licenses/graal-free-license.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://gds.oracle.com/download/graal/25/archive/graalvm-jdk-25.0.5_windows-x64_bin.zip",
            "hash": "192d0328f9ce9c19f1e73278d638c06635e2d5ff744f11ba1c37b23f5db402d2"
        }
    },
    "extract_to": "tmp",
    "installer": {
        "script": [
            "(Get-ChildItem -Directory \"$dir\\tmp\").FullName | % { Move-Item \"$_\\*\" \"$dir\" }",
            "Remove-Item -Recurse \"$dir\\tmp\""
        ]
    },
    "env_add_path": "bin",
    "env_set": {
        "JAVA_HOME": "$dir",
        "GRAALVM_HOME": "$dir"
    },
    "checkver": {
        "url": "https://docs.oracle.com/en/graalvm/jdk/25/docs/release-notes/",
        "useragent": "Mozilla/5.0",
        "regex": ">Oracle GraalVM (\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)<"
    },
    "autoupdate": {
        "url": "https://gds.oracle.com/download/graal/25/archive/graalvm-jdk-$version_windows-x64_bin.zip"
    }
}
