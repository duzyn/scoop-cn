        "arm64": {
            "url": "https://dl.google.com/release2/chrome/jprjlq6h74yif535pr74zjxy3i_152.0.7973.0/152.0.7973.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "b9137b858c0fa849102dd9f01f403ad205c1bafe78fca75d289601afbbc05b95"
