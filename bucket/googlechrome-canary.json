        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/gybncu2qstur6wupopjepiurxy_153.0.7982.0/153.0.7982.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "12d9043e077e55955f0b12c55df3fce2a2bb6daeac22205756df110c4fa49bbe"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad5h67xqqy2e5z6bsrri2tljk4ea_153.0.7982.0/153.0.7982.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "06957961118a3f6a764fa66122f8c56894c6fac4638855cf0d102b4a8c8a5892"
