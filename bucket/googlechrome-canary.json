            "hash": "8b4c3b86fe78bd3439cc29dd1b1f329028630152d4841fb9a623862183def3a9"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ac6v56afphzvtz5ck6tg46b2tjaq_154.0.8013.0/154.0.8013.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "dccf599ab1ca265022f7f73711fbf951a1939dd44b73bf1bcf8bacb12d4bd4bb"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/gp5whs2hbjryiguos3lr56reyu_154.0.8013.0/154.0.8013.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "bd196e46366cfc74f0ec2c4483ef9ac411635386728761d0f6d31a9b26f8bdb8"
