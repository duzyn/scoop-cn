            "hash": "ab26bf207bbf0884f1fe4b67d0a9451186a51ee9d537ffc624877658b566ad01"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ac4cig4wtaae5ntdyukca5hp4ilq_153.0.7997.0/153.0.7997.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "280726aa08d001ca174770862da546cddfeceb9e1fa69a0d5bba4a6197fd21ad"
