            "hash": "b02ec53b097aeac99a0dc6c52ae8f9b6ab04e9deb55da2d259cb19ca64acfb90"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/eurp575rmw562vi7gtfzajvc2m_156.0.8071.0/156.0.8071.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "28ca437e763bc917460d36126083b67dff6cd7c30fcd9d9b95e449c578d95660"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/h5wl3i2flookb3tzhxddzpehvm_156.0.8071.0/156.0.8071.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "b6a1d1391e50ac3a3440070a064491c4eea0c7feec697213a81ac3cdc2a93e79"
