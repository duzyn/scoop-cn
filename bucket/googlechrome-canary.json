        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/glcvb32kt3m6vlayyrs4p37jvy_158.0.8108.0/158.0.8108.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "99303054fb095d07e266945db06c7bcde7f9f7596cbcdfaf1feb8770cc436668"
