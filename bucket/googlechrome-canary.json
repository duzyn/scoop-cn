            "hash": "c6e76a4aff72950829fb1c738618859702d8b0cf81e231144f529d426460e3d2"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/kulylb2m3pwdbztc3pqmpab25u_153.0.8004.0/153.0.8004.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ac429a60be59f8da4e3eb6f9b83aa71afd33d16c48ba62e6788c965f2016d1ad"
