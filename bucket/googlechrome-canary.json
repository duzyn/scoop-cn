            "hash": "d95e6eeef1b067e88696534c7b70c288720e725711371cfb674fc06040bb6aec"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acqvcsyjjxdfltuvghwdnj2n5ssq_158.0.8120.0/158.0.8120.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "5d5d668a4bcd9e3969e683797062f2ae041a8bf061c3195e1550168a6005b001"
