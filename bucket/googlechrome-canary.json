            "hash": "6bc5d2d976fa7c122d889c3d9f30365d205624c5296bc7fc8f0fbd7093f67093"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acs7sd7oa5xkjorg4k2igbhqtfaq_157.0.8084.0/157.0.8084.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "df2e1b380e8491041d532cc57adafa9300ad1a2f7569a10240b238456bc3d1fa"
