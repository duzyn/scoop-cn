            "hash": "68b6da171601639beda3aa6369d93f5ceb172d7fe89b37e42420f2c5e84c473f"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/acbhrehdr3ewg7edfjtivtoduu4q_158.0.8107.0/158.0.8107.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ffc95971166d6fa0023880fdb74fbf09e049348c79668c977bea96d29af05d40"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/fo6vh4l7nxudkibnquyr4ngo4q_158.0.8107.0/158.0.8107.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3d4526df788f1f060a631d2aae49055c20237cc9aab1402e0543a57bf33e4f39"
