            "hash": "c96385d4d61a939e19d2b637763ce867cb55fbeab0442305980abfc506173dcc"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adtajxx522wd3qbhunbcmjiiqjzq_158.0.8105.0/158.0.8105.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "7eaf5eaa2b40d8ead4331bdd3495fe73c3b41bbb21aeee867cc2c883a2f03253"
