            "hash": "948f94ef866744ca4fa4b0a77fc522d59daaecc3f53c21b4333d05332c3d7170"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acb63ipv4cikfxup47mmlyc5b3la_155.0.8041.0/155.0.8041.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "cbba26d46f44050f9266d44ec115d5deb7adbd1da1a12359948a2e4bb1c9e749"
