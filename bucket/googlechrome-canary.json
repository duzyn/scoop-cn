            "hash": "6547a1f6e86bf9173d5a8908d6f4003060c17c3291e65a065f5c03abea4e33bd"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/eu474ggnwuxyqtmutdm74y74vi_153.0.7986.0/153.0.7986.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "cfa491d53c9ffea3c8190d7d94cea0cf7525717efdba812a42a5708eaf6a9ada"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/omhtfra3l6ygth3rajvaszogp4_153.0.7986.0/153.0.7986.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "22ca8d8d9b71beca7cf484c12982f710cfb382c8da80f3d1cab1e9341e5b2787"
