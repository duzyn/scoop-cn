            "hash": "d219e5b9ddd3e25bf22d9dcc3102655404ff63e1144aa63fa2110b876b2fdc2a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acm46gk6d6ioujkpryd4azydevla_153.0.7983.0/153.0.7983.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "d60b9689cc5c1fbb4b2e8a593edd94e050913d406bad832d747b62f5039d606a"
