        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/lhfi2brspqjv2ipr2nfd7zvjda_153.0.7987.0/153.0.7987.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "8ffa65aece17074bb9a08381ae153bb3ab6e7e7c04b3cd3ee4196b85c612f4ce"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acw2vuaihe5yi4w6t3vdksedhp3q_153.0.7987.0/153.0.7987.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "5dabd74643bf6d47822641603a3fc49741ac13e95104107caca36c94819eb9a2"
