            "hash": "6226bf80610f8c1f8bf449949ae9ab219b1e45ad471dae2f72bf8ad5d952f71f"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad3tecw7pnx2d3dsekogwmaoemrq_157.0.8101.0/157.0.8101.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "85f70697078f6beddbee82d9f4cd678605e61fdb9e54db9619e9f0dc4436aa02"
