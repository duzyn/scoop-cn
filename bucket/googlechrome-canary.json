            "hash": "1283c766d3cc7f9e62755374ea7e7825e8f563c61c8e498e4b78bea8507c7b75"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acmhtywudnoniuvodmb7kei55fvq_160.0.8174.0/160.0.8174.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e663f19327704486cf54d1a4dc2d42409b28763288b749bbba5c21b006aff0e9"
