            "hash": "ca7b6c8bbebe24e7b735e96f6455adf2a47c74dae23a0235225487b63671221e"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/it6e4jjnd5hau4loh3hyjowlwm_160.0.8168.0/160.0.8168.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "37666212905cf6846f73db915279fa3cf7ad773a3a8d8dc14c0d97955c5ba98a"
