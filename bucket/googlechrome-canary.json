        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adqu5f6pw4aiy55gof2ytnxka3ga_159.0.8149.0/159.0.8149.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "cf832802020961a7741bfdb12e5777018c8fe5f2e3039da04424997f81219e7d"
