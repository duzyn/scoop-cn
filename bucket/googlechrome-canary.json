        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/oo54gf5vyzkckytq2tbqmq54uy_155.0.8043.0/155.0.8043.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "8450dd6989d5481c30dc4abfd251186825cb342cd5d32325a584d685e17b3fcc"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/advhtwhlkl2yo7bmbmwqbtlgvfaq_155.0.8043.0/155.0.8043.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "d46313b6532d121fd88a1f9964dd40ec0cb6dc273bb801c3ab462b7c532f70b3"
