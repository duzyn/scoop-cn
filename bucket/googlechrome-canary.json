        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ew522jzdrxhe2egde6na6scr6m_154.0.8018.0/154.0.8018.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "80b13331be294113f21898f76c05980ee68346f0de9647ff6b6a35c352ff5598"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/hzcqb5dxktvtbmxtuk5bzgxbme_154.0.8018.0/154.0.8018.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "2cb94dc2a030bcf3a6c3b86e05a0301bafaee7b5ca00683fba5ce7308a7b26a2"
