        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ac4rapvv7azu5qmcusgmy6x7yloq_153.0.7983.3/153.0.7983.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e7e41b58f167c6c5b6b237000442c657f65992fc4a1fe0617ab611cb1397435d"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ka6yhdlq65gd2tcl6gfewtgi3m_153.0.7983.3/153.0.7983.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "15eb46a7102ef8658a84931b7c1e9fd3cd205759dda16b3147d6552a01b6a959"
