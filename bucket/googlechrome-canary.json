            "hash": "941a55335c41aa63169e6eda1922d85d7c91185a2b60d685378d3b5b0cd43d9a"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/acwnwwy5tsccxlojmvjcopo26irq_159.0.8133.0/159.0.8133.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "9971fc902d9c91f7ec71bef7e3c71f3e78b1b84d158e314398d4862979d9eca2"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad4csb6ugy5vvjzygokye4yl3roa_159.0.8133.0/159.0.8133.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "b240feba5279fa12722ddf2385afd61797b5d477d77407044e51665450fa680a"
