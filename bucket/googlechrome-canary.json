            "hash": "0b430ab668f43fdcd7fe458d5603b0e93a6c955d8e73fd4f884d6d924aa4650a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/go6p7dec3vifcwqjjjngkd36mu_160.0.8184.0/160.0.8184.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "4301915addc2cb12922be6b44107a3902fad1a5f630d80ece2322f4fc0a96e85"
