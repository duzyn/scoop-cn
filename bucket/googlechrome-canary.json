            "hash": "0823893b75124f4b823e15694d3e1c2195edb74cd4581cb54b78cf89202be140"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/acnfjfzie7aybl4dpmeotpzlnq5q_159.0.8135.0/159.0.8135.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "eade8f388870ca9ef2d568907193ef1a92aa737fdfbff83136ca045c6c09b93a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/pextnhxlx6nqneaoikdgafiul4_159.0.8135.0/159.0.8135.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "2d9294c5220802f90710ca21108b0af51f3286e52289d7fe2529770f572be16e"
