        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ace2vqe4kbxeget7a4qtbcfzlwtq_159.0.8141.0/159.0.8141.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "8433236dbbbc3048d4df3842a99c1bcba7d69d22f2bfa5f0ad6e3434e4e4aa6c"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adcvaas4rw7m6a4kvo32accs7epa_159.0.8141.0/159.0.8141.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "62d687665aa1165475443a8232ef97fc1cc25feb2881763367d2c8a1a5dd277c"
