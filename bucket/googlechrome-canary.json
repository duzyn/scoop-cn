            "hash": "55d22d7589fe421bc6146a1ce8e79eb62a37b2e61ff28566cf77f94ec8bb9a15"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/o5y4xezuspeain47wvcfy43jma_157.0.8102.0/157.0.8102.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "952a62b52bb269522659b243a8afcedab4120793d9e971e1563784ece08754a9"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/h7tiugwqwzrqkij25bhqzm2nsm_157.0.8102.0/157.0.8102.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "21eb5db14342dae514112bff787208837ad2fc80480fed13bdc36468e3370225"
