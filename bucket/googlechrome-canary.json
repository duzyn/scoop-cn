            "hash": "2862d675e1c237a48d848782fb10c59fabc86d15222e8674cbe56a85b3bb79d6"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ddp2uxsxkms2veeljlfbz346ji_160.0.8155.0/160.0.8155.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ef7d2628ed0813f7853b3a0ed639582c9f11147f8014d0b161b6ecc3b1f3c8c7"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/hlqsshich47epi62zdoxpindka_160.0.8155.0/160.0.8155.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e5f71780c080b8c4111a577259e084fce4f1bedbbd609ebc5f231f1c91b23d16"
