            "hash": "6fdcf53ecb171cf5b7693d4d4613d1ca84912d15714df26231a3861bc7f8528e"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adxozp4x6xwoh5ob4fwsm64hek7a_153.0.7978.0/153.0.7978.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "b6051fd5e2a1cf8d1f144d7539389ccf86f2fd59520a7ec3bab6c2ebe29ee1de"
