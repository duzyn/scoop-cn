        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adfbyn5ya7aiynyddldlbfwl5lvq_154.0.8030.0/154.0.8030.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "64e6b01720c6f34d3f9b3e9630b3e7fb384c89815c81538db5a6d38d2fa4a948"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/cungodronz4cmtcnw362zwdkki_154.0.8030.0/154.0.8030.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "80d19f62d963e3784e0dcf685a90a8ecc4b372de865e5b8ddc4523e40000086d"
