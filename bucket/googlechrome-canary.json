        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad7tylbiel3zehyhkczwurzcb3ea_153.0.7988.1/153.0.7988.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "1736617f2afda003b5e3d0fe0b62b15feaeabf839e05e1612e8146a3263a94d9"
