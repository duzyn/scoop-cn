        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/efjtkrneskkctqmdb2b4bb4mya_154.0.8020.0/154.0.8020.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "5442b09c6e94b139a3d381ca0d08e335183cd8fc9d6fb64d7020c4303169c833"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ovkuonfpc3vn3qbkehpfllgptm_154.0.8020.0/154.0.8020.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ebb5a42928b926bc450045d6d1fce81faa8c2c6ddb3ba828aaa65f0123d94ceb"
