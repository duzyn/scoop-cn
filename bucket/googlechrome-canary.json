            "hash": "77d06aa8464faf51ffa977086a8d5f88a2a4029bd3cc36d5cc82f6e90a6512c9"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ac4ceia227lfqa2x6cv5rhjhkooq_153.0.8005.0/153.0.8005.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "13fd020474a4678a07c7b7754875a1cd93e0480d5a5c9bb529d97803df196cb3"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/f7kzfdjhbgghhn45rlaanc4e7q_153.0.8005.0/153.0.8005.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "856baf70f91ede4ea516f966e0fe8155d26841df2c3c2e79f1e0f656b60c3c22"
