            "hash": "481fcbb355fd0abec2dbd652568295b0415e2be0b13b3044ca082f9228ddf0b4"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/no7z3z47474amtbtzwtfdzfn4q_158.0.8123.0/158.0.8123.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "71e306db8e52631e8be85ababbf2ab8918a51775de8390fe97e8c565169a3b9d"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/p5ugebxen3xxhqnzeihc3y6gsy_158.0.8123.0/158.0.8123.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "74265aaf7dd945f0b5f3e481a13906ed0235054df33f58d6c58861bde4dc10a4"
