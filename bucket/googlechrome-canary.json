            "hash": "c50bdb90e1fd3c21d6e98d86c9a33956bdb24e52e75b722335155f1a78b9ad52"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adjnrcxrzj3a26327ubeevoowfka_155.0.8049.0/155.0.8049.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3159d1ac0856d2bec7fb33217cd22be108b4499e7ead2e69e6a3215474cef63a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ac34qsqfzf4o3osg7gawknkpt4pa_155.0.8049.0/155.0.8049.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "1fdbb31593b6cbd730afab05156f0456715b298d8633089a3acb8f9a93a3468a"
