        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/actgnqg5ezdqtq4vu3tycxyaanta_153.0.7994.0/153.0.7994.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "6ff4b8a30440a5cbdce3c550c47d90bf503f52ef1139f3109232e26addeb6261"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adqj4j6zttvueszzcchnfdthq6eq_153.0.7994.0/153.0.7994.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "fec2d044542169de151d763b23c0f0858bbd6aa08f09beb0ceecf4f4f42b8275"
