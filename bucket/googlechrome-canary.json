            "hash": "5f8e2738cabf2730b4e57bc0a1b7cb13666b4901df0f602b46995a580374eb9b"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ct5g56xtd3rlhsekj54r6qsoge_154.0.8022.0/154.0.8022.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "4e5312662ddcb31e97e110eca15d7fbf0dc5cf393d79aee3eec40ad25ac9ff91"
