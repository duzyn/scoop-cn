        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adsigfup4nddusfnonxe4bc7ekva_155.0.8047.0/155.0.8047.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3e5108eb09d3312dd087a741e2ce1d1aa3638e1fce2fb36a814f1d7991166da1"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adoj7h7p7sqqn7a2gofjwo3owfba_155.0.8047.0/155.0.8047.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "494851c466d663274f530739cb63726d2fe97e554211e1b453cc027b783ae3a1"
