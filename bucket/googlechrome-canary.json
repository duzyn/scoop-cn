        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/hrfqtk62ettggz6ezq6dmzpdcy_159.0.8147.0/159.0.8147.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "43f8a226ca0a274e2355d3d12d811230e085064ce2d77c17bab39d44c81c58c8"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/e5ky4fucsrgl76u5a5qthgccf4_159.0.8147.0/159.0.8147.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "93b69c5ea13d5f487ed19ffd9b615368da675c82dd846f4d5ad3d5ffb25abd61"
