        "arm64": {
            "url": "https://dl.google.com/release2/chrome/advx225l5neabrq5x3wubeudqbya_158.0.8109.0/158.0.8109.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "38e7faa048220e6f77d455ad169416136eff49667f87ddfc4fb3531c1f16e860"
