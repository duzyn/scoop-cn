            "hash": "014335f8f04c23574c1a1f2babb5b02e1e5290fe491b7d43fa50aa9415e9c134"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adwm6i5qhw76gqtixwtvf3fwx7xq_152.0.7976.0/152.0.7976.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "f67c57feb6451326402fea955d2db9a29e09c8ec389fe7b59ab3b6fa060b0dfe"
