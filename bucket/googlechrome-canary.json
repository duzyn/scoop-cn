            "hash": "0304753f7263d135a9c5ae6fb70ae91999dc350e7bf8e5d81c41504699faa522"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/pqfsci3pigybqrvqjx2g2vieha_153.0.7990.0/153.0.7990.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "05ea263bfc0fcd6f3de10b9dfd7ba06ca4722db8beb18c593c3a12df18b571f1"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/advmnmjmk72y36ta6y42prmlwctq_153.0.7991.0/153.0.7991.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "1a890c7ade0b79d1f4304300f1804012e1187b847ac2723575df570aa819fab8"
