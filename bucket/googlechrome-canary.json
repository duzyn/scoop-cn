            "hash": "27cae7384bf22d5b32a792f719deb061a3e3a620f2ff7f5d12c4a85e600509e5"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ntefkbanyldy7vycgrjj3aj6ze_155.0.8058.0/155.0.8058.0_chrome_installer_uncompressed.exe#/dl.7z",
