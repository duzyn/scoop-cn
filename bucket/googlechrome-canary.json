            "hash": "d8575feeaae6dcb108135f513b9fef38b3fd874ec7a5a595d21be431c83a8806"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acef2jhtxoeuydjq64oj3xrs3naq_153.0.7992.3/153.0.7992.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "132f5fbbcc36a29375117e059c47055ceefa9ffd244aad77d22aa836c77f9aba"
