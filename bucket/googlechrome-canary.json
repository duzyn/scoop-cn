            "hash": "05c1f5abe9c5432d71def5c342d12767418849e294b5ef0bbfdf709b35fe96ed"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adw7cuyapz3t2av32xynt4y5ogya_154.0.8011.0/154.0.8011.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "c1ac75b1e866d5e7623fd433b4f2cd8228d712e3ed2eda82dff857edc720a3f2"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acf6dontokdcynkasaapdyzigo4a_153.0.8010.3/153.0.8010.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "edd4c403c75c7922d867877631ee8964bf7e69f6d75e3d8324bc4bb88b8138b7"
