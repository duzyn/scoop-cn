            "hash": "4aee52398ee25e9e3a66606aa9474bfb3852d872a04f7835e29c34f1f18abc5d"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acmuc25eqpa5qf4shgnlti3qhqkq_159.0.8152.0/159.0.8152.0_chrome_installer_uncompressed.exe#/dl.7z",
