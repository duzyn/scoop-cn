        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ioltig2amy6rr2zy235xzhkxpe_159.0.8137.0/159.0.8137.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "29996f764eeab5acfc739c5750a1ccf58542257d977f58389a45d4890c641ac2"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad7mmwwjxh3ksfih7mboog3eu7ca_159.0.8137.0/159.0.8137.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "33b5682b280b6eab3dd43acbdf22d52df441cc3e6fd8a952659401eb0cbad848"
