            "hash": "c28f680db8bdd9899d543bc0dd3ebedc9aca5558862167a0915daee38674fa36"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ac7nr7vy2ifrfla733n2yrxotx6a_157.0.8082.0/157.0.8082.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "044e15e552945bc1643a64f1cf8842a5812736cf1b90abf1119f4bcefeef3e58"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/o7mmn3uy4rrxxepj2lgb2yeeg4_157.0.8082.0/157.0.8082.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "005e61e39e02681b83dd9c17c8b42c3ff333db0c48f2735f94f189489b5237bb"
