            "hash": "3300b6bca7f952ec374f9b4018dc71db50edb1f18aa7b5c2701c026d05b5be3c"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/gddzmybzo2svpqjyisdhotaf4y_154.0.8012.0/154.0.8012.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e1306a5f869b86af231cf64af9b85640d9ea5d50c49072f7ff3e061cfe577225"
