        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/adpppxgh6n3wpvvug4yg53e6m2wa_159.0.8145.0/159.0.8145.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "60cec427992119a1f5f1f2d75ed718b3d4f6cd4b8010812d365a5401a1086de6"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/g7vxn4qihzdguappveajjn2svy_159.0.8145.0/159.0.8145.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e84bc675ae99c2eb5c9853862070918c0abd30d3a846bc6f8ff181acbd572309"
