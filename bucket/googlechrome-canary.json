        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/g3ypimi5xz56bbyephcgjq4rcq_154.0.8035.0/154.0.8035.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "574832fc888c467ecc71fd884228c6950ab9ea440441c16ac8d0c9be2af45080"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adkjoz5fktb5zq3dflal2utdyoeq_154.0.8035.0/154.0.8035.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "c604e45deecffe3cc590d000107a285d927fda93b23a7a92bc4b644c5ef2d094"
