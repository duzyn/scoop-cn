            "hash": "1a438c0e226ea73b8a8ee7117b442aa81b84e8cb98883faa3048ef14826bd687"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/gl43dqclouw2czolp2h2arhtka_159.0.8131.0/159.0.8131.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "a634a56bcb21efc567be10bb7f3fe353cd825cb1bb176e8825fc612ec9464b37"
