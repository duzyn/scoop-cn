            "hash": "99db63a2acf89f794497435b4ed93ae2072125b7a9fe68289ea61e4531865a22"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ipuoeg5fnp7rcnihyjj5uuvjde_160.0.8176.0/160.0.8176.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "9355e359f56db9ab16de67bd4d961ae5a58af52eed1931ad0fda2b0b229a6577"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad6xnxp2q2iefl77vzgz6xeknuuq_160.0.8176.0/160.0.8176.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "cdd4f662c22132338da4883e6e8de35c931289b3cedbbb6c597d9f65abddba84"
