            "url": "https://dl.google.com/release2/chrome/dlrvpep53lbrch2moruccjhaje_155.0.8039.0/155.0.8039.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "11973d37cfcfaa22c230ba7401054686a97d8b279a3bc8689967b6b48888d0ad"
