            "hash": "d69fff535057efa3e5c036da3035d48257909aa3f6fa1187fbdcb891185be895"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/acprlqatakz56cymlrmzhl7cp5rq_156.0.8066.0/156.0.8066.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "4d8c908b60d3d31c4671df356edd1f62cde1bd04f4af89e69062bd1ae9ad437d"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/nqcibjahtsmhfftbwuhyjbn3hy_156.0.8066.0/156.0.8066.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "efd9fc6edca50cd98e9f92cfb0b04eb21a382df54b2fdfd5b34f8f7938c9cf92"
