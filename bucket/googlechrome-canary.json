            "hash": "df57c5bd3876ad3fa85a4c52a632707819f7aa59671cbda427c11c6ad29b372e"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/gvzovdwrtilrlo5skk4c4nqlly_158.0.8122.0/158.0.8122.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "733c757c43aa2f89144629fe7044d33a837c49dcf9d3afaca162259655ad432a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ief6qliibnujpcyamgysksuvh4_158.0.8122.0/158.0.8122.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "1a0690e54a504f7166c7d7cb96192164ae1cf2f1386ec06c7a84f2fdfd6a0eed"
