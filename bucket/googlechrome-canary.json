            "hash": "4c90bb8b5d0e3cf451729b875624757486989059cab11c8bd53596a9e7b32be1"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/pqfsci3pigybqrvqjx2g2vieha_153.0.7990.0/153.0.7990.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "05ea263bfc0fcd6f3de10b9dfd7ba06ca4722db8beb18c593c3a12df18b571f1"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/nfy5dgug5z6fu6yut44yk73liy_153.0.7989.1/153.0.7989.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "a553999604f79673e2fcc10da7bb075f1ebed4e33f5d1fb8c97c4a58e0025403"
        }
