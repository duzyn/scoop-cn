        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/bg5kpoyhzwefbz5mgcuxrcijcq_153.0.7989.3/153.0.7989.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "0fd43fd9eab2461d0ab397da271cd58febc5f196124df08e70d3113da5055fff"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/hhyce2dxpp7bxj722j4fmrqike_153.0.7989.3/153.0.7989.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "f1a9dcd6eadf77c93106ffdd7c2e392d71fe34563c4b75344b1a5efb7dd12623"
