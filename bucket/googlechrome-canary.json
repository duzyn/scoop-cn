        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/cwnucptzxbb7eqnr7uhhmmgzuu_159.0.8143.0/159.0.8143.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "123098ad2de491c62ad747e1c2bb0405f15d480e35fea537ac2d5f86db92ba4e"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/gvxzevv6rwqyvmsvqhfed25dlq_159.0.8143.0/159.0.8143.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e3a8b4a3445e1697459e40e46a6e59cd01ab12ab15e80931f9c9edaea637766a"
