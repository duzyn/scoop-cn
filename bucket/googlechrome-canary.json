            "url": "https://dl.google.com/release2/chrome/ad2bs2kbazild4rgmzsf7sb74trq_153.0.8007.0/153.0.8007.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "010a1bf7e175ea7c93d3ae809ee238841718c82d2542eeb127003aa4f2f552e6"
