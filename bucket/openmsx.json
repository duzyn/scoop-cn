    "license": "GPL-2.0",
    "notes": "User data are stored in C:\\Users\\[USERNAME]\\Documents\\openMSX",
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/openMSX/openMSX/releases/download/RELEASE_22_0/openmsx-22.0-windows-vc-x64-bin.zip",
