        }
    },
    "bin": "openmsx.exe",
    "shortcuts": [
        [
            "openmsx.exe",
            "openMSX\\openMSX"
        ],
        [
            "Catapult\\bin\\Catapult.exe",
            "openMSX\\Catapult"
        ]
    ],
    "checkver": {
        "regex": "openmsx-([\\d.]+)-windows-vc-x64-bin\\.zip"
    },
    "autoupdate": {
