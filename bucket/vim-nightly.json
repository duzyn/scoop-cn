{
    "version": "9.2.1046",
    "description": "A highly configurable text editor for efficiently creating and changing any kind of text.",
    "homepage": "https://www.vim.org",
    "license": "Vim",
    "notes": "Add gVim as a context menu option by running: \"$dir\\install-context.reg\"",
    "suggest": {
        "vimtutor": "vimtutor"
    },
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/vim/vim-win32-installer/releases/download/v9.2.1046/gvim_9.2.1046_x64.zip",
            "hash": "a1030dc9a270befed19c8327b1b86ee938e673444d4d9e6aadc512666f27c046"
        },
        "32bit": {
            "url": "https://gh-proxy.org/https://github.com/vim/vim-win32-installer/releases/download/v9.2.1046/gvim_9.2.1046_x86.zip",
            "hash": "8beb4a2ed6d50d9d94681412d39a3d8f8279a27dbd8f36ea949480479f87c027"
        }
    },
    "extract_dir": "vim\\vim92",
    "post_install": [
        "Remove-Item \"$dir\\`$*\", \"$dir\\uninstal.*\", \"$dir\\install.exe\" -Recurse",
        "'install-context.reg', 'uninstall-context.reg' | ForEach-Object {",
        "    $vimpath = \"$dir\\gVim.exe\".Replace('\\', '\\\\')",
        "    $content = (Get-Content \"$bucketsdir\\main\\scripts\\vim\\$_\").Replace('$vim', $vimpath)",
        "    if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "    Set-Content \"$dir\\$_\" $content",
        "}"
    ],
