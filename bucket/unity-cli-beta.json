            "hash": "abf92f4fb5636144dadabe5ba8e7001a2957996ea33638bc5e9497da7f879f72"
        },
        "arm64": {
            "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/1.0.0-beta.4/unity-windows-arm64.exe#/unity.exe",
