    },
    "architecture": {
        "64bit": {
            "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/1.0.0-beta.15/unity-windows-x64.exe#/unity.exe",
            "hash": "d0b19648ec313017958649abf524b8779fb0aadcdeb65ff7bb54a96bb1c1f0bb"
        },
        "arm64": {
            "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/1.0.0-beta.15/unity-windows-arm64.exe#/unity.exe",
            "hash": "d871f7b6d84c9e414eb16a52258c4730a75ca215166249a3eb3e0cb1574b13da"
        }
    },
    "bin": "unity.exe",
    "checkver": {
        "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/latest-beta.json",
        "jsonpath": "$.version",
        "regex": "(\\d+(?:\\.\\d+)+-beta\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/$version/unity-windows-x64.exe#/unity.exe"
            },
            "arm64": {
                "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/$version/unity-windows-arm64.exe#/unity.exe"
            }
        },
        "hash": {
            "url": "$baseurl/latest.json",
            "jsonpath": "$..[?(@.filename == '$basename')].sha256"
        }
    }
}
