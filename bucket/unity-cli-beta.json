        }
    },
    "bin": "unity.exe",
    "checkver": {
        "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/latest-beta.json",
        "jsonpath": "$.version",
        "regex": "(\\d+(?:\\.\\d+)+-beta\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/$version/unity-windows-x64.exe#/unity.exe"
            },
            "arm64": {
                "url": "https://public-cdn.cloud.unity3d.com/hub/prod/cli/$version/unity-windows-arm64.exe#/unity.exe"
            }
        },
        "hash": {
            "url": "$baseurl/latest.json",
            "jsonpath": "$..[?(@.filename == '$basename')].sha256"
        }
    }
}
