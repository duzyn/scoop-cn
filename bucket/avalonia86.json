{
    "version": "1.5.3",
    "description": "Configuration manager for 86Box",
    "homepage": "https://github.com/notBald/Avalonia86",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/notBald/Avalonia86/blob/master/LICENSE"
    },
    "notes": [
        "ATTENTION: You must manually set the path to the 86box executable within the app.",
        "  1. Run 'scoop prefix 86box' in a terminal and copy the output.",
        "  2. Open Avalonia 86, click 'Tools' > 'Program Settings'.",
        "  3. Paste the path into the 86box executable path field.",
        "Learn more: https://github.com/notBald/Avalonia86#how-to-use"
    ],
    "depends": [
        "86box",
        "86box-roms"
    ],
    "suggest": {
        ".NET Desktop Runtime 9.0": "windowsdesktop-runtime-9.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/notBald/Avalonia86/releases/download/v1.5.3/Avalonia-86-for-Windows-x64-v1.5.3.zip",
            "hash": "bc04474b649974f898a32e6dcc344b6249b71dfc45425b40ec4b520f0454134f"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/notBald/Avalonia86/releases/download/v1.5.3/Avalonia-86-for-Windows-ARM64-v1.5.3.zip",
            "hash": "56dc304636b4418bfa9e31b445fd201ba9a767465b91d0a4b913ecb3f20dc022"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-Item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   New-Item \"$persist_dir\\Avalonia86.sqlite\" -ItemType File | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "Avalonia86.exe",
            "Avalonia 86"
        ]
    ],
    "persist": "Avalonia86.sqlite",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/notBald/Avalonia86/releases/download/v$version/Avalonia-86-for-Windows-x64-v$version.zip"
            },
            "arm64": {
                "url": "https://gh-proxy.org/https://github.com/notBald/Avalonia86/releases/download/v$version/Avalonia-86-for-Windows-ARM64-v$version.zip"
            }
        }
    }
}
