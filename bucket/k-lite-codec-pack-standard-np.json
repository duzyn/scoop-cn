    "uninstaller": {
        "file": "unins000.exe",
        "args": [
            "/verysilent",
            "/nocancel",
            "/norestart"
        ]
    },
    "checkver": {
        "url": "https://codecguide.com/download_k-lite_codec_pack_standard.htm",
        "regex": "Version ([\\d.]+) Standard"
    },
    "autoupdate": {
        "url": "https://files3.codecguide.com/K-Lite_Codec_Pack_$cleanVersion_Standard.exe",
        "hash": {
            "url": "https://codecguide.com/download_k-lite_codec_pack_standard.htm",
            "find": "([a-fA-F0-9]{64})"
        }
    }
