{
    "version": "0.2.2-rc.2",
    "description": "Open-source agent harness developed by DeepSeek AI (desktop preview).",
    "homepage": "https://deepseek.com/harness",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.2-rc.2-win-x64.exe#/dl.7z",
            "hash": "sha512:e6b440915aee2a49b82842c06d3a95f1916b3304a8de81129f35dbf5e6e42563c231ee96b8739141947adee63e06a01ceac05dc81b7049e96c08687493535c24",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
            ]
        }
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness (Preview)"
        ]
    ],
    "checkver": {
        "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
        "regex": "version: ([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
            "regex": "(?s)sha512:.*?$base64"
        }
    }
}
